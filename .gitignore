tests/.fixture-trees/
.venv/

# Pack-local pipeline scripts are tracked source.
!tools/
!tools/**
tools/__pycache__/

# Transient fixture and stage scratch.
.fixture-trees/
/_proof_*
/_scout2_*
*.tmp
*.tmp.*
*.partial
*.part
*.temp

# Explicit local-only staging for artifacts that exceed the current Git
# policy. Every file here must be listed in extracted/PROOF.md with path,
# bytes, hash, and production-sync readiness.
extracted/.local-large/
data/local-corpus/
data/production-staging/

# Generated product artifacts under extracted/ are intentionally NOT ignored.
# Files below ~95 MB are committed; larger reconstructible streams are
# sharded; genuinely larger files move to the staging paths above.

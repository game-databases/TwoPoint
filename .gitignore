.agents/
.claude/
__pycache__/
.pytest_cache/
tests/.fixture-trees/
.venv/

# pack-local pipeline scripts are tracked source, not the Windows-only
# toolchain the root `tools/` rule targets (anvil-empire precedent)
!tools/
!tools/**
tools/__pycache__/

# extraction outputs stay local (game data never enters git); only the
# markdown layer of extracted/ is tracked (EXTRACTION-LOG.md, placeholder
# pointers, MEDIA-CATALOGUE.md)
extracted/**
!extracted/**/
!extracted/**/*.md

# fixture trees also get built at pack root by probe runs
.fixture-trees/

# orchestrator probe scratch (transient)
/_proof_*
/_scout2_*

# Game data staged from NE8K — never enters git (AGENTS.md rule 5, DR-2026-08-29-corpus-on-mac)
data/
